# Environment variables — copy to .env and fill in values
# Never commit real secrets

PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://shopsphere:shopsphere@localhost:5432/shopsphere?schema=public
REDIS_URL=redis://localhost:6379

# Comma-separated list of allowed CORS origins
# In development, any http://localhost:<port> origin is also allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:8082,http://localhost:19006

# JWT signing secret — use a strong random value in production
JWT_SECRET=change-me-in-production-use-long-random-string
